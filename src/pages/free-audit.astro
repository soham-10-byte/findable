---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';

const pageTitle = 'Free SEO, AEO and GEO Audit | Findable';
const pageDescription = 'Request a comprehensive, manual technical audit of your website. We inspect Core Web Vitals, schema integrity, and search and AI engine visibility.';

const breadcrumbs = [
  { name: 'Home', url: 'https://TODO_DOMAIN/' },
  { name: 'Free Audit', url: 'https://TODO_DOMAIN/free-audit' },
];

const formEndpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || 'https://api.web3forms.com/submit';
const web3FormsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || '';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schemaOptions={{
    title: pageTitle,
    description: pageDescription,
    url: 'https://TODO_DOMAIN/free-audit',
    breadcrumbs,
  }}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="section section--paper">
    <div class="container audit-layout">
      <!-- Left: Value Proposition -->
      <div class="audit-info">
        <span class="label-mono">MANUAL TECHNICAL INSPECTION</span>
        <h1>Get your free SEO, AEO and GEO audit</h1>
        <p class="audit-intro">
          We don't send automated PDF dumps. A senior technical specialist manually examines your website to identify what is stopping Google and AI answer engines from recommending your brand.
        </p>

        <div class="audit-checklist">
          <h3>What we analyze in your audit:</h3>
          <ul class="checklist">
            <li>
              <Icon name="check" size={20} />
              <div>
                <strong>Mobile Core Web Vitals &amp; Speed:</strong>
                <span>Analysis of your LCP, INP, and CLS scores under throttled 4G conditions.</span>
              </div>
            </li>
            <li>
              <Icon name="check" size={20} />
              <div>
                <strong>AI Crawler Permissions &amp; Scrapability:</strong>
                <span>Review of robots.txt, HTML source rendering, and accessibility for OAI-SearchBot and PerplexityBot.</span>
              </div>
            </li>
            <li>
              <Icon name="check" size={20} />
              <div>
                <strong>Schema Entity Graph Validation:</strong>
                <span>Inspection of your JSON-LD structured data for missing entity linkages and rich result eligibility.</span>
              </div>
            </li>
            <li>
              <Icon name="check" size={20} />
              <div>
                <strong>AEO Snippet &amp; Direct Answer Potential:</strong>
                <span>Evaluation of high-intent question capture and featured snippet opportunities.</span>
              </div>
            </li>
          </ul>
        </div>
      </div>

      <!-- Right: Audit Form -->
      <div class="audit-form-card">
        <h2>Request your inspection</h2>
        <p class="form-subtext">Delivered directly to your inbox within 48 business hours.</p>

        <form action={formEndpoint} method="POST" class="audit-form">
          {web3FormsKey && <input type="hidden" name="access_key" value={web3FormsKey} />}
          <input type="hidden" name="subject" value="New Free Audit Request from Findable Website" />
          <input type="hidden" name="from_name" value="Findable Audit Lead" />
          <input type="hidden" name="redirect" value="/thank-you" />
          <input type="checkbox" name="botcheck" class="sr-only" aria-hidden="true" tabindex="-1" style="display: none;" />

          <!-- Honeypot anti-spam field -->
          <div class="sr-only" aria-hidden="true">
            <label for="company_fax">Leave this field blank</label>
            <input type="text" id="company_fax" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>

          <div class="form-group">
            <label for="name">Your name <span class="required">*</span></label>
            <input type="text" id="name" name="name" required placeholder="Alex Mercer" autocomplete="name" />
          </div>

          <div class="form-group">
            <label for="email">Work email <span class="required">*</span></label>
            <input type="email" id="email" name="email" required placeholder="alex@company.com" autocomplete="email" />
          </div>

          <div class="form-group">
            <label for="website">Website URL <span class="required">*</span></label>
            <input type="url" id="website" name="website" required placeholder="https://example.com" />
          </div>

          <div class="form-group">
            <label for="business_type">Business type <span class="required">*</span></label>
            <select id="business_type" name="business_type" required>
              <option value="" disabled selected>Select your model</option>
              <option value="local">Local Business / Service Provider</option>
              <option value="d2c">D2C Brand</option>
              <option value="ecommerce">E-commerce Store</option>
              <option value="b2b_saas">B2B / SaaS</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div class="form-group">
            <label for="notes">Current search or AI challenges (optional)</label>
            <textarea id="notes" name="notes" rows="3" placeholder="Tell us about specific queries you want to rank for or traffic drops you've observed..."></textarea>
          </div>

          <div class="form-consent">
            <p>
              By submitting this form, you agree to our <a href="/privacy">Privacy Policy</a>. We never share or sell your contact information.
            </p>
          </div>

          <Button type="submit" variant="primary" class="form-submit-btn">
            Send me my free audit <Icon name="arrow-right" size={16} />
          </Button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .audit-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    align-items: flex-start;
  }

  @media (min-width: 960px) {
    .audit-layout {
      grid-template-columns: 1.1fr 1fr;
    }
  }

  .audit-info h1 {
    margin-block: var(--space-2) var(--space-4);
  }

  .audit-intro {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin-bottom: var(--space-6);
  }

  .audit-checklist {
    background-color: var(--mist);
    padding: var(--space-5);
    border-radius: var(--radius-md);
  }

  .audit-checklist h3 {
    font-size: 1.15rem;
    margin-bottom: var(--space-4);
  }

  .checklist {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .checklist li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: 0.95rem;
  }

  .checklist :global(svg) {
    color: var(--orange);
    margin-top: 0.15rem;
  }

  .checklist strong {
    display: block;
    color: var(--ink);
    margin-bottom: 0.1rem;
  }

  .checklist span {
    color: var(--text-muted);
    line-height: 1.4;
  }

  /* Form Card */
  .audit-form-card {
    background-color: var(--paper);
    border: var(--border);
    border-radius: var(--radius-md);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  .audit-form-card h2 {
    font-size: 1.5rem;
    margin-bottom: var(--space-1);
  }

  .form-subtext {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: var(--space-5);
  }

  .audit-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .form-group label {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--ink);
  }

  .required {
    color: var(--orange);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    min-height: 44px;
    padding: 0.65rem 0.85rem;
    border: var(--border);
    border-radius: var(--radius-sm);
    background-color: #fff;
    color: var(--ink);
    font-size: 1rem;
    transition: border-color 150ms ease;
  }

  .form-group textarea {
    min-height: 80px;
    resize: vertical;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: var(--ink);
    outline: 2px solid var(--focus);
    outline-offset: 1px;
  }

  .form-consent {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .form-submit-btn {
    width: 100%;
    margin-top: var(--space-2);
  }
</style>

