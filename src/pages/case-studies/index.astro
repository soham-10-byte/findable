---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import Cta from '../../components/ui/Cta.astro';

const pageTitle = 'SEO and AI Visibility Case Studies | Findable';
const pageDescription = 'Real technical case studies and measurable performance teardowns showing how we build search dominance and AI answer citations.';

const breadcrumbs = [
  { name: 'Home', url: 'https://TODO_DOMAIN/' },
  { name: 'Case Studies', url: 'https://TODO_DOMAIN/case-studies' },
];

const caseStudies = await getCollection('case-studies');
caseStudies.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schemaOptions={{
    type: 'CollectionPage',
    title: pageTitle,
    description: pageDescription,
    url: 'https://TODO_DOMAIN/case-studies',
    breadcrumbs,
  }}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="section section--paper">
    <div class="container">
      <div class="page-header">
        <span class="label-mono">VERIFIABLE PERFORMANCE</span>
        <h1>Technical case studies &amp; search benchmarks</h1>
        <p class="direct-answer">
          Explore documented proof of how Findable builds ultra-fast, zero-bloat static websites, achieves 100/100 Core Web Vitals on mobile, and earns persistent citations across ChatGPT, Perplexity, and Google AI Overviews.
        </p>
      </div>

      <div class="case-studies-grid">
        {caseStudies.map((study) => (
          <article class="case-study-card">
            <div class="case-study-card__header">
              <span class="case-study-card__industry">{study.data.industry}</span>
              <span class="case-study-card__client">{study.data.client}</span>
            </div>

            <h2 class="case-study-card__title">
              <a href={`/case-studies/${study.slug}`}>
                {study.data.title}
              </a>
            </h2>

            <p class="case-study-card__description">
              {study.data.description}
            </p>

            {study.data.stats && (
              <div class="case-study-card__stats">
                {study.data.stats.map((stat) => (
                  <div class="stat-pill">
                    <span class="stat-pill__value">{stat.value}</span>
                    <span class="stat-pill__label">{stat.label}</span>
                  </div>
                ))}
              </div>
            )}

            <div class="case-study-card__action">
              <a href={`/case-studies/${study.slug}`} class="case-study-link">
                Read full case study &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Cta
    headline="Want similar speed and citation benchmarks for your website?"
    subhead="Request your free, comprehensive technical audit today."
    buttonText="Claim your free audit"
    buttonHref="/free-audit"
  />
</BaseLayout>

<style>
  .page-header {
    margin-bottom: var(--space-8);
    max-width: 52rem;
  }

  .page-header h1 {
    margin-block: var(--space-2) var(--space-4);
  }

  .direct-answer {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .case-studies-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .case-study-card {
    background-color: var(--paper);
    border: var(--border);
    border-radius: var(--radius-md);
    padding: clamp(1.75rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition: transform 150ms ease, border-color 150ms ease;
  }

  .case-study-card:hover {
    border-color: color-mix(in srgb, var(--ink) 35%, transparent);
    transform: translateY(-2px);
  }

  .case-study-card__header {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  .case-study-card__industry {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background-color: var(--lime);
    color: var(--ink);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
    font-weight: 700;
  }

  .case-study-card__client {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .case-study-card__title {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    line-height: 1.2;
    margin: 0;
  }

  .case-study-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .case-study-card__title a:hover {
    text-decoration: underline;
  }

  .case-study-card__description {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .case-study-card__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-block: var(--space-2);
  }

  .stat-pill {
    background-color: var(--mist);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
  }

  .stat-pill__value {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ink);
  }

  .stat-pill__label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .case-study-link {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
  }
</style>
