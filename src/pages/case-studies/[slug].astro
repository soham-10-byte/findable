---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import Cta from '../../components/ui/Cta.astro';

export async function getStaticPaths() {
  const caseStudies = await getCollection('case-studies');
  return caseStudies.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

interface Props {
  study: CollectionEntry<'case-studies'>;
}

const { study } = Astro.props;
const { Content } = await study.render();

const rawTitle = study.data.seoTitle || `${study.data.title} | Findable Case Study`;
const pageTitle = rawTitle.includes('Findable') ? rawTitle : `${rawTitle} | Findable`;
const pageDescription = study.data.seoDescription || study.data.description;
const canonicalURL = `https://findableseo.vercel.app/case-studies/${study.slug}`;

const breadcrumbs = [
  { name: 'Home', url: 'https://findableseo.vercel.app/' },
  { name: 'Case Studies', url: 'https://findableseo.vercel.app/case-studies' },
  { name: study.data.title, url: canonicalURL },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalURL}
  type="article"
  image={study.data.image}
  imageAlt={`${study.data.title} | Findable Case Study`}
  publishedTime={study.data.pubDate.toISOString()}
  modifiedTime={study.data.updatedDate?.toISOString() || study.data.pubDate.toISOString()}
  schemaOptions={{
    title: pageTitle,
    description: pageDescription,
    url: canonicalURL,
    breadcrumbs,
    blogPost: {
      title: study.data.title,
      description: study.data.description,
      url: canonicalURL,
      datePublished: study.data.pubDate.toISOString().split('T')[0],
      dateModified: (study.data.updatedDate || study.data.pubDate).toISOString().split('T')[0],
    },
  }}
>
  <Breadcrumbs items={breadcrumbs} />

  <article class="case-study-article">
    <!-- Article Header -->
    <header class="section section--ink case-study-hero">
      <div class="container">
        <div class="case-study-hero__meta">
          <span class="label-mono label-mono--lime">{study.data.industry}</span>
          <span class="case-study-hero__client">&bull; {study.data.client}</span>
        </div>

        <h1 class="case-study-hero__title">{study.data.title}</h1>
        <p class="case-study-hero__summary">{study.data.description}</p>

        {study.data.stats && (
          <div class="case-study-hero__stats">
            {study.data.stats.map((stat) => (
              <div class="stat-badge">
                <span class="stat-badge__value">{stat.value}</span>
                <span class="stat-badge__label">{stat.label}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </header>

    <!-- Content Body -->
    <section class="section section--paper">
      <div class="container article-container">
        <div class="prose">
          <Content />
        </div>
      </div>
    </section>
  </article>

  <Cta
    headline="Ready to build benchmark-setting search performance for your brand?"
    subhead="Request your free SEO, AEO, and GEO technical audit today."
    buttonText="Claim your free audit"
    buttonHref="/free-audit"
  />
</BaseLayout>

<style>
  .label-mono--lime {
    color: var(--lime);
  }

  .case-study-hero {
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    border-bottom: var(--border-dark);
  }

  .case-study-hero__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .case-study-hero__client {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--sage);
  }

  .case-study-hero__title {
    max-width: 48rem;
    margin-bottom: var(--space-4);
  }

  .case-study-hero__summary {
    font-size: 1.2rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--paper) 85%, transparent);
    max-width: 52rem;
    margin-bottom: var(--space-6);
  }

  .case-study-hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    background-color: #161618;
    padding: var(--space-4);
    border-radius: var(--radius-md);
    border: var(--border-dark);
    max-width: fit-content;
  }

  .stat-badge {
    display: flex;
    flex-direction: column;
    padding-inline: var(--space-3);
    border-right: 1px solid rgba(255, 255, 255, 0.15);
  }

  .stat-badge:last-child {
    border-right: none;
  }

  .stat-badge__value {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--lime);
  }

  .stat-badge__label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    color: var(--sage);
  }

  .article-container {
    max-width: 50rem;
    margin-inline: auto;
  }

  /* Prose styling */
  .prose :global(h2) {
    font-size: 1.85rem;
    margin-top: var(--space-7);
    margin-bottom: var(--space-3);
  }

  .prose :global(h3) {
    font-size: 1.35rem;
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }

  .prose :global(p) {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: var(--space-4);
    color: var(--text);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: var(--space-5);
    padding-left: var(--space-6);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .prose :global(li) {
    margin-bottom: var(--space-2);
  }

  .prose :global(pre) {
    background-color: var(--ink);
    color: var(--paper);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    overflow-x: auto;
    font-size: 0.9rem;
    margin-bottom: var(--space-5);
  }
</style>
