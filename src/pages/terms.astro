---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import { siteConfig } from '../config/site';

const pageTitle = 'Terms of Service – Website Usage & Conditions | Findable';
const pageDescription = 'Findable terms of service governing website use, service audits, and agency client relationships.';

const breadcrumbs = [
  { name: 'Home', url: 'https://findableseo.vercel.app/' },
  { name: 'Terms of Service', url: 'https://findableseo.vercel.app/terms' },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schemaOptions={{
    title: pageTitle,
    description: pageDescription,
    url: 'https://findableseo.vercel.app/terms',
    breadcrumbs,
  }}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="section section--paper">
    <div class="container legal-container">
      <span class="label-mono">AGREEMENT</span>
      <h1>Terms of Service</h1>
      <p class="legal-date">Last updated: October 2026</p>

      <div class="prose">
        <h2>1. Acceptance of Terms</h2>
        <p>
          By accessing this website (<a href="https://findableseo.vercel.app">https://findableseo.vercel.app</a>) or requesting a free technical audit, you agree to be bound by these Terms of Service and all applicable laws and regulations.
        </p>

        <h2>2. Services and Audits</h2>
        <p>
          Information provided on this site, including free technical audits, is offered for informational and advisory purposes. While we adhere strictly to official search engine and AI model documentation:
        </p>
        <ul>
          <li>We do not guarantee specific ranking positions, traffic figures, or AI citation frequencies, as search engines update algorithms autonomously.</li>
          <li>All formal client engagements are governed by separate, signed master services agreements (MSAs) defining specific deliverables and commercial terms.</li>
        </ul>

        <h2>3. Intellectual Property</h2>
        <p>
          All proprietary methodology, original branding, design systems, and code frameworks displayed on this website are the intellectual property of {siteConfig.name} ({siteConfig.legalName}) unless otherwise attributed.
        </p>

        <h2>4. Governing Law</h2>
        <p>
          These terms shall be governed by and construed in accordance with the laws of {siteConfig.contact.country}, without regard to its conflict of law provisions.
        </p>
        <p>
          For inquiries regarding these terms, contact <a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-container {
    max-width: 50rem;
    margin-inline: auto;
  }

  .legal-container h1 {
    margin-block: var(--space-2) var(--space-2);
  }

  .legal-date {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: var(--space-6);
  }

  .prose h2 {
    font-size: 1.5rem;
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .prose p {
    font-size: 1.05rem;
    line-height: 1.65;
    margin-bottom: var(--space-4);
    color: var(--text);
  }

  .prose ul {
    margin-bottom: var(--space-5);
    padding-left: var(--space-5);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .prose li {
    margin-bottom: var(--space-2);
  }
</style>

