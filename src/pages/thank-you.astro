---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';

const pageTitle = 'Audit Request Received | Findable';
const pageDescription = 'Thank you for requesting your free SEO, AEO and GEO audit. Our team is preparing your manual inspection.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  noindex={true}
>
  <section class="section section--paper thank-you-section">
    <div class="container thank-you-container">
      <div class="success-icon">
        <Icon name="check" size={36} />
      </div>

      <span class="label-mono">REQUEST RECEIVED</span>
      <h1>Your technical audit is underway</h1>
      <p class="thank-you-message">
        Thank you for submitting your website. A senior search and AI technical specialist has received your URL and will complete your manual inspection within 48 business hours.
      </p>

      <div class="next-steps-card">
        <h3>What happens next?</h3>
        <ol class="steps-list">
          <li><strong>Domain Crawl:</strong> We initiate an automated sweep of your mobile Core Web Vitals, HTML static output, and robots directives.</li>
          <li><strong>Entity &amp; Schema Audit:</strong> We inspect your JSON-LD graphs against schema.org and Google Rich Results standards.</li>
          <li><strong>AI Prompt Battery:</strong> We query ChatGPT Search and Perplexity with high-intent queries relevant to your industry.</li>
          <li><strong>Executive Delivery:</strong> You will receive a personalized teardown identifying your highest-priority fixes.</li>
        </ol>
      </div>

      <div class="thank-you-actions">
        <Button href="/" variant="primary">
          Return to homepage
        </Button>
        <Button href="/blog" variant="secondary">
          Explore our search &amp; AI guides
        </Button>
      </div>
    </div>
  </section>

  <!-- GA4 Lead Conversion Event -->
  <script is:inline>
    if (typeof gtag === 'function') {
      gtag('event', 'generate_lead', {
        event_category: 'Conversion',
        event_label: 'Audit & Contact Form Submission',
        value: 1
      });
    }
  </script>
</BaseLayout>

<style>
  .thank-you-section {
    min-height: 70vh;
    display: flex;
    align-items: center;
  }

  .thank-you-container {
    max-width: 44rem;
    text-align: center;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .success-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-color: var(--lime);
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
  }

  h1 {
    margin-block: var(--space-2) var(--space-3);
  }

  .thank-you-message {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }

  .next-steps-card {
    background-color: var(--mist);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    text-align: left;
    width: 100%;
    margin-bottom: var(--space-6);
  }

  .next-steps-card h3 {
    font-size: 1.15rem;
    margin-bottom: var(--space-3);
  }

  .steps-list {
    margin: 0;
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-size: 0.95rem;
  }

  .steps-list li strong {
    color: var(--ink);
  }

  .steps-list li {
    color: var(--text-muted);
  }

  .thank-you-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: center;
  }
</style>

