---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import Tag from '../../components/ui/Tag.astro';
import Cta from '../../components/ui/Cta.astro';

const pageTitle = 'SEO, AEO and GEO Blog | Findable';
const pageDescription = 'Explore technical teardowns, search optimization guides, and generative AI citation strategies from the engineering and SEO team at Findable.';

const breadcrumbs = [
  { name: 'Home', url: 'https://findableseo.vercel.app/' },
  { name: 'Blog', url: 'https://findableseo.vercel.app/blog' },
];

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schemaOptions={{
    type: 'CollectionPage',
    title: pageTitle,
    description: pageDescription,
    url: 'https://findableseo.vercel.app/blog',
    breadcrumbs,
  }}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="section section--paper">
    <div class="container">
      <div class="page-header">
        <span class="label-mono">KNOWLEDGE BASE</span>
        <h1>Technical guides for SEO, AEO and GEO</h1>
        <p class="direct-answer">
          Practical teardowns and authoritative guides explaining how search engines index pages, how answer engines extract featured snippets, and how generative models cite sources.
        </p>
      </div>

      <div class="blog-grid">
        {posts.map((post) => {
          const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
          });
          return (
            <article class="post-card">
              <div class="post-card__tags">
                {post.data.tags.map((tag) => (
                  <Tag variant="neutral">{tag}</Tag>
                ))}
              </div>

              <h2 class="post-card__title">
                <a href={`/blog/${post.slug}`}>
                  {post.data.title}
                </a>
              </h2>

              <p class="post-card__description">
                {post.data.description}
              </p>

              <div class="post-card__meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {formattedDate}
                </time>
                <span class="post-card__author">&bull; By {post.data.author}</span>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <Cta
    headline="Want an expert evaluation of your search and AI visibility?"
    subhead="Request your free, comprehensive technical audit today."
    buttonText="Claim your free audit"
    buttonHref="/free-audit"
  />
</BaseLayout>

<style>
  .page-header {
    margin-bottom: var(--space-8);
    max-width: 52rem;
  }

  .page-header h1 {
    margin-block: var(--space-2) var(--space-4);
  }

  .direct-answer {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-6);
  }

  .post-card {
    background-color: var(--paper);
    border: var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: transform 150ms ease, border-color 150ms ease;
  }

  .post-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--ink) 35%, transparent);
  }

  .post-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .post-card__title {
    font-size: 1.35rem;
    line-height: 1.3;
    margin: 0;
  }

  .post-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .post-card__title a:hover {
    text-decoration: underline;
  }

  .post-card__description {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
    flex-grow: 1;
  }

  .post-card__meta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    padding-top: var(--space-3);
    border-top: var(--border);
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }
</style>
