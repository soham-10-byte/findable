---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import Tag from '../../components/ui/Tag.astro';
import Faq from '../../components/ui/Faq.astro';
import Icon from '../../components/ui/Icon.astro';
import Cta from '../../components/ui/Cta.astro';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

const rawTitle = post.data.seoTitle || post.data.title;
const pageTitle = rawTitle.includes('Findable') ? rawTitle : `${rawTitle} | Findable`;
const pageDescription = post.data.seoDescription || post.data.description;
const canonicalURL = `https://findableseo.vercel.app/blog/${post.slug}`;

const breadcrumbs = [
  { name: 'Home', url: 'https://findableseo.vercel.app/' },
  { name: 'Blog', url: 'https://findableseo.vercel.app/blog' },
  { name: post.data.title, url: canonicalURL },
];

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdatedDate = post.data.updatedDate
  ? post.data.updatedDate.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalURL}
  type="article"
  image={post.data.image}
  imageAlt={post.data.imageAlt || `${post.data.title} | Findable Article`}
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={post.data.updatedDate?.toISOString() || post.data.pubDate.toISOString()}
  schemaOptions={{
    title: pageTitle,
    description: pageDescription,
    url: canonicalURL,
    breadcrumbs,
    faqs: post.data.faqs,
    blogPost: {
      title: post.data.title,
      description: post.data.description,
      url: canonicalURL,
      datePublished: post.data.pubDate.toISOString().split('T')[0],
      dateModified: (post.data.updatedDate || post.data.pubDate).toISOString().split('T')[0],
      faqs: post.data.faqs,
    },
  }}
>
  <Breadcrumbs items={breadcrumbs} />

  <article class="post-article">
    <header class="section section--ink post-header">
      <div class="container post-header__container">
        <div class="post-header__tags">
          {post.data.tags.map((tag) => (
            <Tag variant="seo">{tag}</Tag>
          ))}
        </div>

        <h1 class="post-header__title">{post.data.title}</h1>
        <p class="post-header__description">{post.data.description}</p>

        <div class="post-header__byline">
          <span>By <a href="/about" class="author-link">{post.data.author}</a></span>
          <span class="meta-separator">&bull;</span>
          <span>Published <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time></span>
          {formattedUpdatedDate && (
            <>
              <span class="meta-separator">&bull;</span>
              <span>Updated <time datetime={post.data.updatedDate?.toISOString()}>{formattedUpdatedDate}</time></span>
            </>
          )}
        </div>
      </div>
    </header>

    <div class="section section--paper">
      <div class="container article-body-container">
        <div class="prose">
          <Content />
        </div>

        <!-- Author & E-E-A-T Credibility Card -->
        <section class="post-author-box">
          <div class="post-author-box__header">
            <span class="label-mono">AUTHOR &amp; REVIEWER</span>
            <span class="verified-badge">
              <Icon name="check" size={14} /> Fact-Checked &amp; Verified
            </span>
          </div>

          <div class="post-author-box__body">
            <div class="post-author-box__avatar" aria-hidden="true">
              <span>DM</span>
            </div>
            <div class="post-author-box__content">
              <h3 class="post-author-box__name">{post.data.author || siteConfig.founder.name}</h3>
              <p class="post-author-box__role">{siteConfig.founder.role} &amp; Technical Search Director, Findable</p>
              <p class="post-author-box__bio">
                Specialist in technical search engine optimization, Core Web Vitals engineering, Answer Engine Optimization (AEO), and Generative Engine Optimization (GEO). Advises growth-stage brands and local businesses on organic visibility and AI search discovery.
              </p>
              <div class="post-author-box__links">
                <a href="/about" class="post-author-box__link">
                  About Findable's Team &rarr;
                </a>
                {siteConfig.founder.linkedin && (
                  <a
                    href={siteConfig.founder.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="post-author-box__link post-author-box__link--social"
                  >
                    LinkedIn Profile <Icon name="external" size={13} />
                  </a>
                )}
                {siteConfig.socials.x && (
                  <a
                    href={siteConfig.socials.x}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="post-author-box__link post-author-box__link--social"
                  >
                    X (Twitter) <Icon name="external" size={13} />
                  </a>
                )}
              </div>
            </div>
          </div>
        </section>

        {post.data.faqs && post.data.faqs.length > 0 && (
          <div class="post-faqs">
            <Faq items={post.data.faqs} title="Key questions answered in this guide" subtitle="" />
          </div>
        )}
      </div>
    </div>
  </article>

  <Cta
    headline="Want to implement these optimizations on your website?"
    subhead="Request your free, comprehensive technical audit today."
    buttonText="Claim your free audit"
    buttonHref="/free-audit"
  />
</BaseLayout>

<style>
  .post-header {
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    border-bottom: var(--border-dark);
  }

  .post-header__container {
    max-width: 52rem;
  }

  .post-header__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .post-header__title {
    margin-bottom: var(--space-4);
  }

  .post-header__description {
    font-size: 1.2rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--paper) 85%, transparent);
    margin-bottom: var(--space-5);
  }

  .post-header__byline {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--sage);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .author-link {
    color: var(--lime);
    text-decoration: underline;
  }

  .meta-separator {
    color: rgba(255, 255, 255, 0.4);
  }

  .article-body-container {
    max-width: 50rem;
    margin-inline: auto;
  }

  .prose :global(h2) {
    font-size: 1.85rem;
    margin-top: var(--space-7);
    margin-bottom: var(--space-3);
  }

  .prose :global(h3) {
    font-size: 1.35rem;
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }

  .prose :global(p) {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: var(--space-4);
    color: var(--text);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: var(--space-5);
    padding-left: var(--space-6);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .prose :global(li) {
    margin-bottom: var(--space-2);
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-block: var(--space-6);
    font-size: 0.95rem;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: var(--space-3) var(--space-4);
    border: var(--border);
    text-align: left;
  }

  .prose :global(th) {
    background-color: var(--mist);
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .prose :global(pre) {
    background-color: var(--ink);
    color: var(--paper);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    overflow-x: auto;
    font-size: 0.9rem;
    margin-bottom: var(--space-5);
  }

  .post-faqs {
    margin-top: var(--space-8);
    padding-top: var(--space-7);
    border-top: var(--border);
  }

  /* Author & E-E-A-T Credibility Box */
  .post-author-box {
    margin-top: var(--space-8);
    padding: var(--space-6);
    background-color: var(--mist);
    border: var(--border);
    border-radius: var(--radius-md);
  }

  .post-author-box__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: var(--border);
  }

  .verified-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--olive);
    background-color: color-mix(in srgb, var(--olive) 15%, transparent);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-pill);
    font-weight: 600;
  }

  .post-author-box__body {
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
  }

  .post-author-box__avatar {
    width: 3.5rem;
    height: 3.5rem;
    min-width: 3.5rem;
    border-radius: var(--radius-pill);
    background-color: var(--ink);
    color: var(--lime);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.1rem;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--ink) 12%, transparent);
  }

  .post-author-box__content {
    flex: 1;
  }

  .post-author-box__name {
    font-size: 1.25rem;
    margin-bottom: 0.2rem;
    color: var(--ink);
  }

  .post-author-box__role {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: var(--space-3);
  }

  .post-author-box__bio {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text);
    margin-bottom: var(--space-4);
  }

  .post-author-box__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
  }

  .post-author-box__link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--cobalt);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .post-author-box__link:hover {
    text-decoration: underline;
  }

  .post-author-box__link--social {
    color: var(--text-muted);
  }

  .post-author-box__link--social:hover {
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .post-author-box__body {
      flex-direction: column;
      gap: var(--space-3);
    }
  }
</style>

