---
import Button from './Button.astro';

interface Props {
  headline?: string;
  subhead?: string;
  buttonText?: string;
  buttonHref?: string;
  secondaryText?: string;
  secondaryHref?: string;
  theme?: 'ink' | 'lime';
  class?: string;
}

const {
  headline = 'Stop being invisible on Google and AI answers.',
  subhead = 'Get a comprehensive audit of your technical SEO, entity clarity, and answer engine readiness.',
  buttonText = 'Get your free audit',
  buttonHref = '/free-audit',
  secondaryText = 'or talk to our team',
  secondaryHref = '/contact',
  theme = 'ink',
  class: className = '',
} = Astro.props;
---

<section class={`cta-band cta-band--${theme} ${className}`}>
  <div class="container cta-band__inner">
    <div class="cta-band__content">
      <span class="label-mono">BE FOUND &bull; BE CITED &bull; BE CHOSEN</span>
      <h2 class="cta-band__title">{headline}</h2>
      <p class="cta-band__subhead">{subhead}</p>
    </div>

    <div class="cta-band__actions">
      <Button href={buttonHref} variant="primary">
        {buttonText}
      </Button>
      {secondaryText && secondaryHref && (
        <a href={secondaryHref} class="cta-band__secondary">
          {secondaryText}
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding-block: clamp(3.5rem, 8vw, 6rem);
    border-top: var(--border);
  }

  .cta-band--ink {
    background-color: var(--ink);
    color: var(--paper);
    border-top: var(--border-dark);
  }

  .cta-band--ink .cta-band__subhead {
    color: color-mix(in srgb, var(--paper) 80%, transparent);
  }

  .cta-band--ink .cta-band__secondary {
    color: var(--lime);
  }

  .cta-band--lime {
    background-color: var(--lime);
    color: var(--ink);
  }

  .cta-band--lime .cta-band__secondary {
    color: var(--ink);
  }

  .cta-band__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .cta-band__inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .cta-band__content {
    max-width: 42rem;
  }

  .cta-band__title {
    font-size: clamp(2rem, 3.5vw + 1rem, 3rem);
    line-height: 1.1;
    margin-bottom: var(--space-3);
  }

  .cta-band__subhead {
    font-size: 1.125rem;
    margin: 0;
  }

  .cta-band__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .cta-band__secondary {
    font-size: 0.95rem;
    font-family: var(--font-heading);
    font-weight: 500;
  }
</style>

