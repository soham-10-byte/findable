---
interface Props {
  size?: 'sm' | 'md' | 'lg' | 'xl';
  theme?: 'light' | 'dark' | 'auto';
  class?: string;
}

const { size = 'md', theme = 'auto', class: className = '' } = Astro.props;
---

<span class={`findable-logo findable-logo--${size} findable-logo--${theme} ${className}`}>
  <span class="sr-only">Findable</span>
  <span aria-hidden="true" class="findable-logo__mark">
    f<span class="findable-logo__stem">ı<i class="findable-logo__dot"></i></span>ndable
  </span>
</span>

<style>
  .findable-logo {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-heading);
    font-weight: 700;
    letter-spacing: -0.035em;
    user-select: none;
    line-height: 1;
    text-decoration: none;
  }

  .findable-logo--sm {
    font-size: 1.25rem;
  }

  .findable-logo--md {
    font-size: 1.65rem;
  }

  .findable-logo--lg {
    font-size: 2rem;
  }

  .findable-logo--xl {
    font-size: 2.5rem;
  }

  .findable-logo--auto {
    color: currentColor;
  }

  .findable-logo--light {
    color: var(--ink);
  }

  .findable-logo--dark {
    color: var(--paper);
  }

  .findable-logo__mark {
    display: inline-block;
    position: relative;
  }

  .findable-logo__stem {
    position: relative;
    display: inline-block;
  }

  .findable-logo__dot {
    position: absolute;
    left: 50%;
    top: 0.12em;
    width: 0.22em;
    height: 0.22em;
    background-color: var(--lime);
    border-radius: 50%;
    transform: translateX(-50%);
    box-shadow: 0 0 1px rgba(0, 0, 0, 0.2);
  }
</style>

