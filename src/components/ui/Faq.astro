---
import Icon from './Icon.astro';
import type { FaqItem } from '../../lib/schema';

interface Props {
  items: FaqItem[];
  title?: string;
  subtitle?: string;
  class?: string;
}

const {
  items,
  title = 'Frequently asked questions',
  subtitle = 'Clear answers about how we optimize your brand for search and AI.',
  class: className = '',
} = Astro.props;
---

<div class={`faq-section ${className}`}>
  {title && (
    <div class="faq-section__header">
      <span class="label-mono">FAQ</span>
      <h2>{title}</h2>
      {subtitle && <p class="faq-section__subtitle">{subtitle}</p>}
    </div>
  )}

  <div class="faq-list">
    {items.map((item, index) => (
      <details class="faq-item" open={index === 0}>
        <summary class="faq-item__question">
          <span class="faq-item__question-text">{item.question}</span>
          <span class="faq-item__icon" aria-hidden="true">
            <Icon name="chevron-down" size={20} />
          </span>
        </summary>
        <div class="faq-item__answer">
          <p>{item.answer}</p>
        </div>
      </details>
    ))}
  </div>
</div>

<style>
  .faq-section {
    width: 100%;
  }

  .faq-section__header {
    margin-bottom: var(--space-6);
  }

  .faq-section__subtitle {
    font-size: 1.125rem;
    color: var(--text-muted);
    margin-top: var(--space-2);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .faq-item {
    border: var(--border);
    border-radius: var(--radius-md);
    background-color: var(--paper);
    overflow: hidden;
    transition: border-color 150ms ease;
  }

  .faq-item:hover {
    border-color: color-mix(in srgb, var(--ink) 30%, transparent);
  }

  .faq-item__question {
    padding: var(--space-4) var(--space-5);
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    user-select: none;
  }

  .faq-item__question::-webkit-details-marker {
    display: none;
  }

  .faq-item__icon {
    display: flex;
    align-items: center;
    transition: transform 200ms ease;
    color: var(--text-muted);
  }

  .faq-item[open] .faq-item__icon {
    transform: rotate(180deg);
    color: var(--ink);
  }

  .faq-item__answer {
    padding: 0 var(--space-5) var(--space-5) var(--space-5);
    color: var(--text);
    font-size: 1rem;
    line-height: 1.6;
  }

  .faq-item__answer p {
    margin: 0;
  }
</style>

