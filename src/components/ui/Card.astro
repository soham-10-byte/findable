---
import Tag from './Tag.astro';
import Icon from './Icon.astro';

interface Props {
  title: string;
  href?: string;
  tag?: string;
  tagVariant?: 'seo' | 'aeo' | 'geo' | 'neutral' | 'ink';
  description?: string;
  theme?: 'paper' | 'mist' | 'ink';
  class?: string;
}

const {
  title,
  href,
  tag,
  tagVariant = 'neutral',
  description,
  theme = 'paper',
  class: className = '',
} = Astro.props;
---

<div class={`card card--${theme} ${className}`}>
  {tag && (
    <div class="card__tag-wrapper">
      <Tag variant={tagVariant}>{tag}</Tag>
    </div>
  )}

  <h3 class="card__title">
    {href ? (
      <a href={href} class="card__stretched-link">
        {title}
      </a>
    ) : (
      title
    )}
  </h3>

  {description && <p class="card__description">{description}</p>}

  <div class="card__content">
    <slot />
  </div>

  {href && (
    <div class="card__action">
      <span class="card__learn-more">
        Learn more <Icon name="arrow-right" size={16} />
      </span>
    </div>
  )}
</div>

<style>
  .card {
    position: relative;
    border-radius: var(--radius-md);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: transform 150ms ease, border-color 150ms ease;
  }

  .card--paper {
    background-color: var(--paper);
    color: var(--ink);
    border: var(--border);
  }

  .card--mist {
    background-color: var(--mist);
    color: var(--ink);
    border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
  }

  .card--ink {
    background-color: var(--ink);
    color: var(--paper);
    border: var(--border-dark);
  }

  .card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--ink) 35%, transparent);
  }

  .card--ink:hover {
    border-color: color-mix(in srgb, var(--paper) 40%, transparent);
  }

  .card__tag-wrapper {
    display: flex;
  }

  .card__title {
    font-size: 1.35rem;
    line-height: 1.25;
    margin: 0;
  }

  .card__stretched-link {
    color: inherit;
    text-decoration: none;
  }

  .card__stretched-link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .card__description {
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
    color: var(--text-muted);
  }

  .card--ink .card__description {
    color: color-mix(in srgb, var(--paper) 80%, transparent);
  }

  .card__content {
    flex-grow: 1;
  }

  .card__action {
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .card__learn-more {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--link);
  }

  .card--ink .card__learn-more {
    color: var(--lime);
  }
</style>

