---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Logo from '../ui/Logo.astro';
import { siteConfig } from '../../config/site';

const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="header__logo" aria-label="Findable homepage">
      <Logo size="md" theme="auto" />
    </a>

    <!-- Desktop Navigation -->
    <nav class="header__nav" aria-label="Main Navigation">
      <ul class="header__nav-list">
        {siteConfig.nav.map((item) => {
          const isActive = currentPath.startsWith(item.href) && item.href !== '/' || currentPath === item.href;
          return (
            <li>
              <a
                href={item.href}
                class={`header__nav-link ${isActive ? 'header__nav-link--active' : ''}`}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Desktop Action -->
    <div class="header__action">
      <Button href="/free-audit" variant="primary">
        Free audit
      </Button>
    </div>

    <!-- Mobile Menu Toggle using pure CSS / HTML details & summary -->
    <details class="mobile-menu">
      <summary class="mobile-menu__toggle" aria-label="Toggle mobile menu">
        <span class="mobile-menu__icon-open">
          <Icon name="menu" size={26} />
        </span>
        <span class="mobile-menu__icon-close">
          <Icon name="close" size={26} />
        </span>
      </summary>
      <div class="mobile-menu__dropdown">
        <nav aria-label="Mobile Navigation">
          <ul class="mobile-menu__list">
            {siteConfig.nav.map((item) => (
              <li>
                <a href={item.href} class="mobile-menu__link">
                  {item.label}
                </a>
              </li>
            ))}
            <li class="mobile-menu__action">
              <Button href="/free-audit" variant="primary" class="mobile-menu__btn">
                Get your free audit
              </Button>
            </li>
          </ul>
        </nav>
      </div>
    </details>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: var(--bg);
    border-bottom: var(--border);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    gap: var(--space-4);
  }

  .header__logo {
    display: flex;
    align-items: center;
    color: var(--ink);
    text-decoration: none;
    z-index: 1002;
  }

  .header__logo:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }

  .header__nav {
    display: none;
  }

  @media (min-width: 860px) {
    .header__nav {
      display: block;
    }
  }

  .header__nav-list {
    display: flex;
    align-items: center;
    list-style: none;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
  }

  .header__nav-link {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    padding-block: var(--space-2);
    position: relative;
    transition: color 150ms ease;
  }

  .header__nav-link:hover {
    color: var(--link);
  }

  .header__nav-link--active {
    color: var(--ink);
  }

  .header__nav-link--active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--lime);
  }

  .header__action {
    display: none;
  }

  @media (min-width: 860px) {
    .header__action {
      display: block;
    }
  }

  /* Mobile menu via details/summary */
  .mobile-menu {
    display: block;
  }

  @media (min-width: 860px) {
    .mobile-menu {
      display: none;
    }
  }

  .mobile-menu__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    cursor: pointer;
    list-style: none;
    color: var(--ink);
    border: var(--border);
    border-radius: var(--radius-sm);
    z-index: 1002;
    position: relative;
  }

  .mobile-menu__toggle::-webkit-details-marker {
    display: none;
  }

  .mobile-menu__icon-close {
    display: none;
  }

  .mobile-menu[open] .mobile-menu__icon-open {
    display: none;
  }

  .mobile-menu[open] .mobile-menu__icon-close {
    display: inline-block;
  }

  .mobile-menu__dropdown {
    position: absolute;
    top: 72px;
    left: 0;
    right: 0;
    background-color: var(--bg);
    border-bottom: var(--border);
    padding: var(--space-5) var(--space-4);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
  }

  .mobile-menu__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
  }

  .mobile-menu__link {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    padding-block: var(--space-2);
  }

  .mobile-menu__action {
    padding-top: var(--space-3);
    border-top: var(--border);
  }

  .mobile-menu__btn {
    width: 100%;
  }
</style>

